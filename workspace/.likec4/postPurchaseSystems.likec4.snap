    {
      id: 'medallia',
      parent: '@gr1',
      level: 1,
      children: [],
      inEdges: [],
      outEdges: [],
      title: 'Medallia',
      modelRef: 'medallia',
      shape: 'rectangle',
      color: 'primary',
      style: {
        border: 'none',
        opacity: 35,
        size: 'md',
      },
      description: {
        txt: 'Gestion de encuestras. Medallia es un SaaS para la Gestion de la Experiencia Cliente (CEM Customer Experience Management) y para la Gestion de Retroalimentacion Empresarial (EFM Enterprise Feedback Management). Como parte de un CRM (o de un CRM Social), Medallia  es una plataforma de software que permite captura voz del cliente, retroalimentacion a traves de la Web, de redes sociales, mobile y de centros de contacto. Analiza esta informacion en tiempo real y entrega flujos de trabajo de accion para ejecutivos, equipos centrales y de primera linea relacionados con satisfaccion y lealtad del cliente, resultados NPS y con el rendimiento general de la empresa.En Sodimac: Usa el servidor Malasia para la transferencia ida-vuelta de archivos con Proveedores externos. Los archivos los provee Adessa. Servidor administrado por Adessa. Transferencia es via SFTP.',
      },
      tags: [
        'post-purchase',
      ],
