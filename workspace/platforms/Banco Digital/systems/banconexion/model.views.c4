views {

    view context-banconexion of banconexion {
    title 'Banco Digital / Banconexion / C4 Level 1: System Context'
    include
      banconexion,
      clienteempresa
  }

  view containers-banconexion of banconexion {
  title 'Banco Digital / Banconexion / C4 Level 2: Containers'
  include
    clienteempresa,
    mobileApp,
    webserver,
    WebLogic,
    esb,
    dbBanconexionApp,
    dbNvaIntEmpresas,
    dbEluEmpresa,
    ap0045Idg
}

  view components-banconexion-weblogic of banconexion.WebLogic {
    title 'Banco Digital / Banconexion / C4 Level 3: Components / WebLogic'
    include
      *,
      banconexion.webserver,
      banconexion.esb,
      banconexion.dbBanconexionApp,
      banconexion.dbNvaIntEmpresas,
      banconexion.dbEluEmpresa,
      banconexion.dbIlcat
  }

  view components-banconexion-esb of banconexion.esb {
    title 'Banco Digital / Banconexion / C4 Level 3: Components / ESB'
    include
      *,
      banconexion.WebLogic.weblogic12,
      banconexion.WebLogic.weblogic11,
      banconexion.ap0045Idg,
      banconexion.ibmOndemand,
      banconexion.ap0500TefMaze,
      banconexion.ap0482Mdm,
      banconexion.ap0035CoreCuenta,
      banconexion.dbRbacCn,
      banconexion.apXxOud
  }
    
}