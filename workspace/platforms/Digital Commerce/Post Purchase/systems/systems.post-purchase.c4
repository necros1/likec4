//systems.post-purchase.c4
model {
    /**********************************************************************
        SYSTEMS - DIGITAL COMMERCE - POST PURCHASE
    **********************************************************************/

    integraPlataformaAutogestion = system 'Integra Plataforma Autogestion' {
        #post-purchase
        description 'Integra es una plataforma de autogestion diseñada para los empleados de Falabella Retail. Ofrece distintos modulos a los que los usuarios pueden acceder segun sus roles y permisos asignados. Entre las principales funcionalidades, se incluyen: Solicitud de permisos Prestamos Solicitud de retiro de cesantias Creacion de incapacidades Ademas, cuenta con muchas otras herramientas que facilitan la gestion de tramites y procesos internos.'
        metadata {
            FAI 'APP00014'
            Delivery 'On-Site'
            Codebase 'Build'
            Lifecycle 'Mantener/Evolucionar'
        }
      integraPlataformaAutogestion -[supportsCapability]-> learning "Supports"
    }


    b2cPortalTottus = system 'B2C - Portal Tottus' {
      #post-purchase      
        metadata {
            FAI 'APP00023'
            Delivery 'On-Site'
            Lifecycle 'Mantener/Evolucionar'
        }

    }

    abmClient = system 'ABM Client' {
      #post-purchase
      description 'Aplicacion para el registro de Alta, Baja y Modificacion de Clientes Empresa. Aplica para todos los canales de venta.'
        metadata {
            FAI 'APP00031'
            Delivery 'On-Site'
            Codebase 'Build'
            Lifecycle 'Deprecar'
        }
        abmClient -[supportsCapability]-> customerAccountAndPreferencesRetail "Supports"
    }

    medallia = system 'Medallia' {
      #post-purchase
      description 'Gestion de encuestras. Medallia es un SaaS para la Gestion de la Experiencia Cliente (CEM Customer Experience Management) y para la Gestion de Retroalimentacion Empresarial (EFM Enterprise Feedback Management). Como parte de un CRM (o de un CRM Social), Medallia  es una plataforma de software que permite captura voz del cliente, retroalimentacion a traves de la Web, de redes sociales, mobile y de centros de contacto. Analiza esta informacion en tiempo real y entrega flujos de trabajo de accion para ejecutivos, equipos centrales y de primera linea relacionados con satisfaccion y lealtad del cliente, resultados NPS y con el rendimiento general de la empresa.En Sodimac: Usa el servidor Malasia para la transferencia ida-vuelta de archivos con Proveedores externos. Los archivos los provee Adessa. Servidor administrado por Adessa. Transferencia es via SFTP.'
        metadata {
            FAI 'APP00046'
            Delivery 'SaaS'
            Codebase 'Buy'
            Lifecycle 'Mantener/Evolucionar'
        }
        medallia -[supportsCapability]-> feedbackAndVoCRetail "Supports"
    }

    falabellaMobile = system 'Falabella Mobile' {
      #post-purchase
      description 'Aplicacion Mobile para Falabella.com'
        metadata {
            FAI 'APP00087'
            Codebase 'Build'
            Lifecycle 'Mantener/Evolucionar'
        }
        falabellaMobile -[supportsCapability]-> mobileApps "Supports"
    }

    vtexCrateBarrel = system 'VTEX-Crate&Barrel' {
      #post-purchase
      description 'Sitio Crate&Barrel'
        metadata {
            FAI 'APP00106'
            Delivery 'Private Cloud Service'
            Lifecycle 'Mantener/Evolucionar'
        }
        vtexCrateBarrel -[supportsCapability]-> availabilityAndShipping "Supports"
        vtexCrateBarrel -[supportsCapability]-> productCatalog "Supports"
    }

    libroReclamaciones = system 'Libro de Reclamaciones' {
      #post-purchase
      description 'Permite a los clientes realizar reclamos y quejas con disponibilidad 24 x 7. Peru'
        metadata {
            FAI 'APP00111'
            Delivery 'Public Cloud Service'
            Codebase 'Build'
            Lifecycle 'Mantener/Evolucionar'
        }
        libroReclamaciones -[supportsCapability]-> caseManagementRetail "Supports"
    }

    zohoCom = system 'Zoho.com' {
      #post-purchase
      description 'Para registro de casos de clientes (generacion de Tickets), relacionados con Venta Telefonica, Atencion al Cliente, Productos a Pedido y Defensa del Consumidor; como tambien para tareas (gestiones) y reportes.'
        metadata {
            FAI 'APP00113'
            Delivery 'Private Cloud Service'
            Codebase 'Build'
            Lifecycle 'Mantener/Evolucionar'
        }
        zohoCom -[supportsCapability]-> caseManagementRetail "Supports"
    }

    salesforceMarketingCloud = system 'Salesforce Marketing Cloud' {
      #post-purchase
      description 'Sistema de Gestion de E-Mail para Marketing'
        metadata {
            FAI 'APP00336'
            Delivery 'Public Cloud Service'
            Codebase 'Buy'
            Lifecycle 'Mantener/Evolucionar'
        }

        // --- CAPACIDADES SOPORTADAS ---
        salesforceMarketingCloud -[supportsCapability]-> campaignOrchestrationRetail "Supports"
        salesforceMarketingCloud -[supportsCapability]-> socialMarketingRetail "Supports"
        salesforceMarketingCloud -[supportsCapability]-> customerNotifications "Supports"
        salesforceMarketingCloud -[supportsCapability]-> marketingContentRetail "Supports"
        salesforceMarketingCloud -[supportsCapability]-> audienceTargeting "Supports"        
    }

    sapf = system 'SAPF' {
      #post-purchase
      description 'En Sodimac existen tres aplicaciones con distinto alcance y tecnologia para la gestion del CES: SAPF (Ch-Br), CES (Pe) y ENGAGE (Ar).El Circulo de Especialistas CES incluye a Carpinteros, Plomeros, Albañiles, Electricistas, etc. y Marketing lleva a cabo programas de fidelizacion para CES consistente en entregar nuevos conocimientos y hacer mas profesional su trabajo, mejorando su calidad de vida. Conceptualmente CES y HOME CLUB son programas de fidelizacion.Considera ENGAGE, Promociones, eMail MKT, folletos, cursos, charlas, etc. e incluye Administracion y Canje de Puntos.1.- Chile//Brasil: SAPF Sistema Administracion de Planes de Fidelizacion: Planes de Fidelizacion, Atributos de clientes, Clientes y planes de fidelizacion con que se relaciona, Administracion de eventos para clientes y Bolsa de trabajo para socios CES.2.- Peru: CES: Inscribir socios, Obtener las transacciones de ventas y Emitir informes de gestion para el area.3.- Argentina: ENGAGE: Inscribir socios, Acumular puntos para canje, Obtener las transacciones de ventas, Emitir informes de gestion para el area, Segmentacion de clientes, Imprimir Re-imprimir tarjeta CES y Asignacion de puntos por referente.'
        metadata {
            FAI 'APP00344'
            Delivery 'Private Cloud Service'
            Codebase 'Build'
            Lifecycle 'Mantener/Evolucionar'
        }
        salesforceMarketingCloud -[supportsCapability]->  loyaltyRetail "Supports"
    }

